# ===== LINE Messaging API（LINE Developers Console → 你的 Channel → Messaging API）=====
LINE_CHANNEL_SECRET=請填入Channel_secret
LINE_CHANNEL_ACCESS_TOKEN=請填入長期Channel_access_token

# ===== 後台登入（帳號 admin，密碼如下；務必修改）=====
ADMIN_PASSWORD=change-me

# ===== 伺服器 =====
PORT=3000
DB_PATH=./data/crm.db
TZ_NAME=Asia/Taipei

# ===== 每日關懷清單 =====
# 每天幾點（當地時間，0-23）產生清單並推播給客服
DAILY_REPORT_HOUR=9
# 客服的 LINE userId（需先加官方帳號好友，可在後台「客戶」中找到自己的 userId），多位用逗號分隔
STAFF_LINE_USER_IDS=

# ===== 規則 =====
# 新訂單預設幾天內要匯款
PAYMENT_DUE_DAYS=3
# 沒有足夠歷史資料時，預設回購週期（天）
DEFAULT_REORDER_DAYS=30
# 新好友幾天內未下單會被列入關懷
NEW_FRIEND_DAYS=7
# 提醒過後，幾天內不再重複列入同一類提醒
REMINDER_COOLDOWN_DAYS=3

# ===== 自動推播（會消耗官方帳號訊息額度）=====
# 每天自動提醒「明天到期 / 今天到期 / 已逾期」未匯款的客戶（每筆訂單最多 3 次）
AUTO_PAYMENT_REMINDER=false
# 每天自動提醒「該回購了」的客戶
AUTO_REORDER_REMINDER=false

# ===== 匯款資訊（會放進提醒訊息）=====
BANK_INFO=銀行代碼 000 帳號 0000-0000-0000 戶名 OOO
SHOP_NAME=我的小店

# 後台網址（每日摘要會附上連結）
PUBLIC_URL=
