# ===== 品牌 / LINE 官方帳號 =====
# 多品牌請直接在後台「品牌」頁新增，每個品牌填自己的 LINE 金鑰與匯款資訊。
# 以下三項只在第一次啟動、還沒有任何品牌時，用來自動建立第一個品牌（代號 default）。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SHOP_NAME=我的小店
BANK_INFO=
# 啟動時自動建立的品牌（代號:名稱:代表色，逗號分隔；每個代號只建立一次）
INITIAL_BRANDS=

# ===== 後台登入（帳號 admin，密碼如下；務必修改）=====
ADMIN_PASSWORD=change-me

# ===== 伺服器 =====
PORT=3000
DB_PATH=./data/crm.db
TZ_NAME=Asia/Taipei

# ===== 每日關懷清單 =====
# 每天幾點（當地時間，0-23）產生清單並推播給客服
DAILY_REPORT_HOUR=9
# 接收每日清單的客服：建議直接在後台客戶資料按「設為客服」。
# 也可在此填 LINE userId（多位用逗號分隔），會用第一個品牌的官方帳號推播。
STAFF_LINE_USER_IDS=

# ===== 規則 =====
# 新訂單預設幾天內要匯款
PAYMENT_DUE_DAYS=3
# 沒有足夠歷史資料時，預設回購週期（天）
DEFAULT_REORDER_DAYS=30
# 新好友幾天內未下單會被列入關懷
NEW_FRIEND_DAYS=7
# 提醒過後，幾天內不再重複列入同一類提醒
REMINDER_COOLDOWN_DAYS=3

# ===== 自動推播（會消耗官方帳號訊息額度）=====
# 每天自動提醒「明天到期 / 今天到期 / 已逾期」未匯款的客戶（每筆訂單最多 3 次）
AUTO_PAYMENT_REMINDER=false
# 每天自動提醒「該回購了」的客戶
AUTO_REORDER_REMINDER=false
# 客人傳「查訂單」、匯款通知時是否自動回覆（預設 false：只記錄、不回覆）
AUTO_REPLY=false


# 後台網址（每日摘要會附上連結）
PUBLIC_URL=
